<Window x:Class="CutMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CutMaker.App"
        Title="CutMaker" Width="1440" Height="920" MinWidth="1000" MinHeight="720"
        FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="13" Foreground="#EAF0FA" Background="#11151D"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="TrackCollapseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="17" /><Setter Property="Foreground" Value="#FFD56A" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TrackMuteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="50" /><Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="3,0" /><Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="#B5C3D8" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="MuteBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MuteBorder" Property="BorderBrush" Value="#78DCCB" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MuteBorder" Property="BorderBrush" Value="#78DCCB" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAudio}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Background" Value="#743C47" /><Setter Property="Foreground" Value="#FFE2E5" /><Setter Property="BorderBrush" Value="#F18C9B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Margin="16" Background="#11151D">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" MinHeight="44" />
            <RowDefinition x:Name="WorkspaceRow" Height="*" MinHeight="220" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="TimelineRow" Height="310" MinHeight="190" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#78DCCB" CornerRadius="6" Padding="10,7" Margin="0,0,12,0"><TextBlock Text="CM" Foreground="#142B2C" FontWeight="Bold" /></Border>
                <TextBlock Text="CutMaker" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="專注每一段畫面與聲音" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="0.7.1 · Fade 即時拖曳" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        </Grid>
        <WrapPanel x:Name="ProjectToolbar" Grid.Row="1">
            <Button Content="新增專案" Click="New_Click" ToolTip="Ctrl+N" />
            <Button Content="開啟專案" Click="Open_Click" ToolTip="Ctrl+O" />
            <Button Content="儲存" Click="Save_Click" ToolTip="Ctrl+S" />
            <Button Content="另存新檔" Click="SaveAs_Click" />
            <Button x:Name="UndoButton" Content="復原" Click="Undo_Click" ToolTip="Ctrl+Z" />
            <Button x:Name="RedoButton" Content="重做" Click="Redo_Click" ToolTip="Ctrl+Y" />
            <Button Content="備份復原" Click="Recovery_Click" />
            <Button Content="輸出設定" Click="OutputSettings_Click" />
            <Button x:Name="ExportButton" Content="匯出 MP4／MP3" Click="Export_Click" Background="#24534D" />
            <Button x:Name="CancelRenderButton" Content="取消匯出" Click="CancelRender_Click" Visibility="Collapsed" />
            <Button Content="重設版面" Click="ResetLayout_Click" />
            <ProgressBar x:Name="RenderProgressBar" Width="100" Height="5" Minimum="0" Maximum="100" VerticalAlignment="Center" Visibility="Collapsed" />
        </WrapPanel>
        <Grid x:Name="Workspace" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="390" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="InspectorColumn" Width="290" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <Border x:Name="LibraryDropZone" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="13"
                    BorderThickness="1" BorderBrush="Transparent" AllowDrop="True"
                    PreviewDragEnter="Library_DragOver" PreviewDragOver="Library_DragOver"
                    PreviewDragLeave="Library_DragLeave" PreviewDrop="Library_Drop">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="素材庫" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Button x:Name="ImportFilesButton" Content="＋ 匯入素材" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,6" Click="ImportFiles_Click" ToolTip="選取一個或多個檔案 · Ctrl+I" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="拖入檔案匯入，再把素材拖到軌道" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" TextWrapping="Wrap" />
                    <DataGrid x:Name="AssetGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" Background="#11151D" Foreground="#EAF0FA"
                              BorderThickness="0" RowBackground="#1D2533" AlternatingRowBackground="#18202B" MinColumnWidth="80" MinRowHeight="32"
                              PreviewMouseLeftButtonDown="AssetGrid_MouseDown" PreviewMouseMove="AssetGrid_MouseMove"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293348" /><Setter Property="Foreground" Value="#C5D2E4" /><Setter Property="Padding" Value="8,9" /></Style></DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,7" /><Setter Property="BorderThickness" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style></DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="AssetNameColumn" Header="素材名稱" Width="260" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding FullPath}" Margin="8,6" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="類型" Binding="{Binding Kind}" Width="90" MinWidth="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="8,6" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="時長" Binding="{Binding Duration}" Width="110" MinWidth="95">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="8,6" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="EmptyLibraryHint" Grid.Row="2" IsHitTestVisible="False" VerticalAlignment="Center" Margin="18,40,18,12">
                        <TextBlock Text="拖入影片、音訊或圖片" Foreground="#C5D2E4" TextAlignment="Center" TextWrapping="Wrap" FontSize="15" />
                        <TextBlock Text="可一次加入多個檔案" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="DropOverlay" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False" Background="#EF213C3A" CornerRadius="4" BorderBrush="#78DCCB" BorderThickness="1" Padding="16">
                        <TextBlock Text="放開以加入素材庫" Foreground="#AFE6DA" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <StackPanel x:Name="ImportProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="CancelImportButton" Content="取消" DockPanel.Dock="Right" Click="CancelImport_Click" Padding="8,3" Margin="6,0,0,0" />
                                <TextBlock x:Name="ImportProgressText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#AFE6DA" />
                            </DockPanel>
                            <ProgressBar Height="3" IsIndeterminate="True" Foreground="#78DCCB" Background="#293348" Margin="0,6,0,0" />
                        </StackPanel>
                        <DockPanel>
                            <Button x:Name="RelinkAssetButton" Content="重新連結" Click="RelinkAsset_Click" DockPanel.Dock="Right" Padding="8,4" Margin="8,0,0,0" ToolTip="重新連結所選素材：來源搬家或遺失時，選擇新的檔案位置" />
                            <TextBlock x:Name="AssetHint" Text="MP4 · MP3 · WAV · PNG · JPG／JPEG" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button x:Name="ImportDetailsButton" Content="查看略過原因" Click="ImportDetails_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="調整素材庫與預覽寬度" DragCompleted="Splitter_DragCompleted" />
            <Border x:Name="PreviewPane" Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14" Focusable="True" InputMethod.IsInputMethodEnabled="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="預覽" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="PreviewFormat" Text="1920 × 1080 · 30 fps" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" /></DockPanel>
                    <Border x:Name="PreviewSurface" Grid.Row="1" Background="#090D13" Margin="0,10,0,8" CornerRadius="4" MinHeight="32" MouseLeftButtonDown="PreviewSurface_MouseDown">
                        <Grid>
                            <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                                          MediaOpened="PreviewPlayer_MediaOpened" MediaEnded="PreviewPlayer_MediaEnded" MediaFailed="PreviewPlayer_MediaFailed" />
                            <Image x:Name="PreviewStillImage" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed" />
                            <TextBlock x:Name="PreviewHint" Text="放入片段後，按更新預覽" Foreground="#C5D2E4" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <Slider x:Name="PreviewSeekSlider" Minimum="0" Maximum="1" ValueChanged="PreviewSeek_ValueChanged" IsMoveToPointEnabled="True" InputMethod.IsInputMethodEnabled="False"
                                PreviewMouseLeftButtonDown="PreviewSeek_PointerDown" PreviewMouseLeftButtonUp="PreviewSeek_PointerUp" ToolTip="拖曳試看／定位播放頭" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="PreparePreviewButton" Content="更新" Click="PreparePreview_Click" Padding="8,5" ToolTip="準備完整預覽；內容未變更時重用快取" />
                            <Button Content="‹" Click="FrameBack_Click" Padding="8,5" ToolTip="前一格 · ←" AutomationProperties.Name="前一格" />
                            <Button x:Name="PreviewPlayButton" Content="播放" Click="PreviewPlay_Click" Padding="8,5" ToolTip="Space" />
                            <Button x:Name="PreviewStopButton" Content="停止" Click="PreviewStop_Click" Padding="8,5" />
                            <Button Content="›" Click="FrameForward_Click" Padding="8,5" ToolTip="後一格 · →" AutomationProperties.Name="後一格" />
                            <Button x:Name="PreviewCancelButton" Content="取消" Click="CancelPreview_Click" Visibility="Collapsed" Padding="8,5" />
                        </WrapPanel>
                        <TextBlock x:Name="PreviewTimeText" Text="00:00.000" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" Foreground="#78DCCB" Margin="0,5,0,0" />
                        <TextBlock x:Name="PreviewRangeText" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="調整預覽與屬性寬度" DragCompleted="Splitter_DragCompleted" />
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="片段與軌道" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock x:Name="ClipNameText" Text="點選時間軸片段" TextWrapping="Wrap" Foreground="#78DCCB" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="起點（秒）" /><TextBlock Grid.Column="2" Text="來源起點（秒）" />
                            <TextBox x:Name="ClipStartBox" Grid.Row="1" Margin="0,4,0,8" /><TextBox x:Name="ClipSourceInBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,8" />
                            <TextBlock Grid.Row="2" Text="長度（秒）" /><TextBlock Grid.Row="2" Grid.Column="2" Text="音量（0–400%）" />
                            <TextBox x:Name="ClipDurationBox" Grid.Row="3" Margin="0,4,0,8" /><TextBox x:Name="ClipGainBox" Grid.Row="3" Grid.Column="2" Margin="0,4,0,8" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="淡入（秒）" /><TextBlock Grid.Column="2" Text="淡出（秒）" />
                            <TextBox x:Name="FadeInBox" Grid.Row="1" Margin="0,4,0,6" /><TextBox x:Name="FadeOutBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,6" />
                            <ComboBox x:Name="FadeInCurveBox" Grid.Row="2" MinHeight="28" SelectionChanged="FadeCurve_SelectionChanged" /><ComboBox x:Name="FadeOutCurveBox" Grid.Row="2" Grid.Column="2" MinHeight="28" SelectionChanged="FadeCurve_SelectionChanged" />
                        </Grid>
                        <Expander Header="進階 Fade／獨立音訊" Foreground="#EAF0FA" Margin="0,10,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="畫面淡化方式" />
                                <ComboBox x:Name="VideoFadeModeBox" MinHeight="28" Margin="0,4,0,8" />
                                <TextBlock Text="自訂曲線控制點（0–1）" />
                                <TextBlock Text="固定時間點 1/3、2/3 的強度；選自訂曲線後可編輯。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6" />
                                <UniformGrid Columns="2">
                                    <TextBlock Text="淡入控制 1" /><TextBlock Text="淡入控制 2" />
                                    <TextBox x:Name="FadeInControl1Box" Margin="0,4,4,6" /><TextBox x:Name="FadeInControl2Box" Margin="4,4,0,6" />
                                    <TextBlock Text="淡出控制 1" /><TextBlock Text="淡出控制 2" />
                                    <TextBox x:Name="FadeOutControl1Box" Margin="0,4,4,6" /><TextBox x:Name="FadeOutControl2Box" Margin="4,4,0,6" />
                                </UniformGrid>
                                <CheckBox x:Name="SeparateAudioFadesBox" Content="音訊使用獨立 Fade" Foreground="#EAF0FA" Checked="EffectsMode_Changed" Unchecked="EffectsMode_Changed" Margin="0,4,0,8" />
                                <UniformGrid Columns="2">
                                    <TextBlock Text="音訊淡入（秒）" /><TextBlock Text="音訊淡出（秒）" />
                                    <TextBox x:Name="AudioFadeInBox" Margin="0,4,4,6" /><TextBox x:Name="AudioFadeOutBox" Margin="4,4,0,6" />
                                    <ComboBox x:Name="AudioFadeInCurveBox" Margin="0,0,4,6" MinHeight="28" SelectionChanged="FadeCurve_SelectionChanged" /><ComboBox x:Name="AudioFadeOutCurveBox" Margin="4,0,0,6" MinHeight="28" SelectionChanged="FadeCurve_SelectionChanged" />
                                    <TextBlock Text="音訊淡入控制 1" /><TextBlock Text="音訊淡入控制 2" />
                                    <TextBox x:Name="AudioFadeInControl1Box" Margin="0,4,4,6" /><TextBox x:Name="AudioFadeInControl2Box" Margin="4,4,0,6" />
                                    <TextBlock Text="音訊淡出控制 1" /><TextBlock Text="音訊淡出控制 2" />
                                    <TextBox x:Name="AudioFadeOutControl1Box" Margin="0,4,4,6" /><TextBox x:Name="AudioFadeOutControl2Box" Margin="4,4,0,6" />
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="預設畫面與聲音共用 Fade。上方影片軌顯示在前景。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,6" FontSize="11" />
                        <Button x:Name="ApplyClipButton" Content="套用片段設定" Click="ApplyClip_Click" Margin="0,4,0,12" />
                        <Expander Header="軌道設定" IsExpanded="True" Foreground="#EAF0FA" Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox x:Name="TrackNameBox" ToolTip="軌道名稱" Margin="0,0,0,8" />
                                <TextBlock Text="軌道音量（0–400%）" />
                                <TextBox x:Name="TrackVolumeBox" Margin="0,4,0,8" />
                                <WrapPanel><CheckBox x:Name="TrackMutedBox" Content="靜音／隱藏" Foreground="#EAF0FA" Margin="0,0,12,0" /><CheckBox x:Name="TrackLockedBox" Content="鎖定" Foreground="#EAF0FA" /></WrapPanel>
                                <Button x:Name="ApplyTrackButton" Content="套用軌道設定" Click="ApplyTrack_Click" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0"><Button Content="上移" Click="MoveTrackUp_Click" Padding="8,5" /><Button Content="下移" Click="MoveTrackDown_Click" Padding="8,5" /><Button Content="刪除軌道" Click="DeleteTrack_Click" Padding="8,5" ToolTip="移除這條軌道與其片段；Ctrl+Z 可復原" /></WrapPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="專案屬性" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,12" />
                        <TextBlock Text="專案名稱" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="ProjectNameBox" Text="未命名專案" TextChanged="ProjectName_TextChanged" TextWrapping="Wrap" MaxLength="200" MinHeight="38" />
                        <TextBlock Text="畫面設定" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,8" />
                        <TextBlock x:Name="ProjectFormat" Text="1920 × 1080 / 30 fps" TextWrapping="Wrap" />
                        <TextBlock Text="專案位置" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,8" />
                        <TextBlock x:Name="ProjectLocation" Text="尚未儲存" TextWrapping="Wrap" Foreground="#C5D2E4" />
                        <TextBlock x:Name="RecoveryStatusText" Text="每 30 秒備份未存變更" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" FontSize="11" />
                        <Border Background="#213C3A" CornerRadius="5" Padding="12" Margin="0,24,0,0">
                            <TextBlock Text="拖曳面板間的分隔線調整空間。版面大小會自動記住。" Foreground="#AFE6DA" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="調整時間軸高度" DragCompleted="Splitter_DragCompleted" />
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="20" /></Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="時間軸" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" />
                    <Button Content="＋ 影片軌" Click="AddVideo_Click" Padding="12,6" />
                    <Button Content="＋ 音訊軌" Click="AddAudio_Click" Padding="12,6" />
                    <Button x:Name="RemoveClipButton" Content="移除片段" Click="RemoveClip_Click" Padding="12,6" IsEnabled="False" ToolTip="選取片段後按 Delete；來源檔案會保留" />
                    <Button x:Name="SplitClipButton" Content="切割" Click="SplitClip_Click" Padding="12,6" ToolTip="將選取片段在播放頭位置切開 · Ctrl+B" />
                    <Menu Background="Transparent" Foreground="#EAF0FA" Margin="0,0,8,8" VerticalAlignment="Center">
                        <MenuItem Header="編輯 ▾" Padding="8,7" Background="#253247" Foreground="#EAF0FA">
                            <MenuItem.Resources><Style TargetType="MenuItem"><Setter Property="Foreground" Value="#17202E" /></Style></MenuItem.Resources>
                            <MenuItem Header="全選片段" InputGestureText="Ctrl+A" Click="SelectAllClips_Click" />
                            <MenuItem Header="取消選取" InputGestureText="Esc" Click="ClearSelection_Click" />
                            <MenuItem Header="剪下" InputGestureText="Ctrl+X" Click="CutClips_Click" />
                            <MenuItem Header="複製" InputGestureText="Ctrl+C" Click="CopyClips_Click" />
                            <MenuItem Header="貼到播放頭" InputGestureText="Ctrl+V" Click="PasteClips_Click" />
                            <MenuItem Header="複製到尾端" InputGestureText="Ctrl+D" Click="DuplicateClips_Click" />
                            <Separator />
                            <MenuItem Header="同軌波紋刪除" InputGestureText="Shift+Delete" Click="RippleDelete_Click" ToolTip="刪除選取片段，將同軌後續片段前移相同長度" />
                            <MenuItem Header="分離音訊並連動" Click="ExtractAudio_Click" />
                            <MenuItem Header="解除連動" Click="UnlinkClips_Click" />
                            <Separator />
                            <MenuItem x:Name="SnapMenuItem" Header="吸附片段邊界" IsCheckable="True" IsChecked="True" InputGestureText="S" Click="SnapTimeline_Click" ToolTip="拖曳時按住 Alt 可暫時停用吸附" />
                            <MenuItem Header="顯示整條時間軸" InputGestureText="Ctrl+0" Click="FitTimeline_Click" />
                            <MenuItem Header="定位">
                                <MenuItem Header="前一格" InputGestureText="←" Click="FrameBack_Click" />
                                <MenuItem Header="後一格" InputGestureText="→" Click="FrameForward_Click" />
                                <MenuItem Header="前一個片段邊界" InputGestureText="Alt+←" Click="PreviousBoundary_Click" />
                                <MenuItem Header="下一個片段邊界" InputGestureText="Alt+→" Click="NextBoundary_Click" />
                                <MenuItem Header="選取範圍起點" Click="SelectedStart_Click" />
                                <MenuItem Header="選取範圍終點" Click="SelectedEnd_Click" />
                                <MenuItem Header="跳至時間…" InputGestureText="Ctrl+G" Click="GoToTime_Click" />
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                    <TextBlock x:Name="TrackCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,18,0">
                        <TextBlock Text="縮放" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="TimelineZoom" Width="100" Minimum="10" Maximum="120" Value="40" ValueChanged="TimelineZoom_Changed" VerticalAlignment="Center" ToolTip="Ctrl＋滾輪縮放；最小可讓整段素材縮至可視軌道的 25%" />
                    </StackPanel>
                </WrapPanel>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TrackHeaderWidth, RelativeSource={RelativeSource AncestorType=Window}}" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="軌道" Foreground="{StaticResource MutedBrush}" />
                    <local:TimelineRuler x:Name="TimelineTimeRuler" Grid.Column="2" PreviewMouseWheel="Timeline_MouseWheel" PixelsPerSecond="{Binding TimelinePixelsPerSecond, RelativeSource={RelativeSource AncestorType=Window}}" OffsetSeconds="{Binding TimelineOffsetSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                         PlayheadSeconds="{Binding PlayheadSeconds, RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="TimelineRuler_MouseDown" MouseMove="TimelineRuler_MouseMove" MouseLeftButtonUp="TimelineRuler_MouseUp" />
                </Grid>
                <Grid x:Name="TimelineContent" Grid.Row="2" SizeChanged="TimelineContent_SizeChanged" PreviewMouseWheel="Timeline_MouseWheel">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TrackHeaderColumn" Width="250" MinWidth="180" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="280" /></Grid.ColumnDefinitions>
                <ScrollViewer x:Name="TimelineTrackScroll" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="TimelineTrackScroll_Changed">
                    <ItemsControl x:Name="TrackItems">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,6" Height="{Binding RowHeight}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TrackHeaderWidth, RelativeSource={RelativeSource AncestorType=Window}}" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Background="#253247" CornerRadius="4,0,0,4" Padding="4,0,6,0" Tag="{Binding Id}" MouseLeftButtonDown="TimelineTrack_MouseDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button x:Name="CollapseTrackButton" Style="{StaticResource TrackCollapseButton}" Content="{Binding CollapseGlyph}" Tag="{Binding Id}" ToolTip="{Binding CollapseToolTip}" AutomationProperties.Name="{Binding CollapseToolTip}" Click="CollapseTrack_Click" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" Foreground="#78DCCB" VerticalAlignment="Center" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding TrackDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="18,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackDetail}" Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                        <Button x:Name="MuteTrackButton" Grid.Column="2" Style="{StaticResource TrackMuteButton}" Content="MUTE" Tag="{Binding Id}" ToolTip="{Binding MuteToolTip}" AutomationProperties.Name="{Binding MuteToolTip}" Click="MuteTrack_Click" />
                                    </Grid>
                                </Border>
                                <local:TimelineLane Grid.Column="2" Tag="{Binding Id}" Clips="{Binding Clips}" IsLocked="{Binding IsLocked}" IsCompact="{Binding IsCollapsed}"
                                                    PixelsPerSecond="{Binding TimelinePixelsPerSecond, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    OffsetSeconds="{Binding TimelineOffsetSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedClipId="{Binding SelectedTimelineClipId, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedClipIds="{Binding SelectedTimelineClipIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    PlayheadSeconds="{Binding PlayheadSeconds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    AllowDrop="True" PreviewDragEnter="TimelineLane_DragOver" PreviewDragOver="TimelineLane_DragOver"
                                                    PreviewDragLeave="TimelineLane_DragLeave" PreviewDrop="TimelineLane_Drop" MouseLeftButtonDown="TimelineLane_MouseDown"
                                                    MouseMove="TimelineLane_MouseMove" MouseLeftButtonUp="TimelineLane_MouseUp" LostMouseCapture="TimelineLane_LostCapture" PreviewMouseRightButtonDown="TimelineLane_RightClick" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragDelta="TrackHeader_DragDelta" DragCompleted="Splitter_DragCompleted" AutomationProperties.Name="調整軌道名稱寬度" />
                    <Canvas Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="TimelineMarqueeRect" Visibility="Collapsed" Fill="#2878DCCB" Stroke="#78DCCB" StrokeThickness="1" />
                    </Canvas>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TrackHeaderWidth, RelativeSource={RelativeSource AncestorType=Window}}" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="空白處拖曳框選 · Ctrl 加選 · ← → 逐格" ToolTip="空白處拖曳框選；Ctrl+框選加入。拖曳中央可整組跨軌，Esc 取消。← → 逐格，Shift+← → 一秒；Home/End 起訖；Ctrl+0 顯示全部；S 切換吸附。" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ScrollBar x:Name="TimelineHorizontalScroll" Grid.Column="2" Orientation="Horizontal" Minimum="0" Maximum="60" SmallChange="1" LargeChange="10"
                               Value="{Binding TimelineOffsetSeconds, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="5" Text="就緒 · 將素材庫的素材拖到對應軌道" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
